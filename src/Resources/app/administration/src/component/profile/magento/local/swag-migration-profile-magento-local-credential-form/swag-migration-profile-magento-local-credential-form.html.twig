<div class="swag-migration-wizard swag-migration-wizard-page-credentials"
     @keypress.enter="onKeyPressEnter">
    {% block swag_migration_magento_wizard_page_credentials_content %}
        <div class="swag-migration-wizard__content">
            {% block swag_migration_magento_wizard_page_credentials_information %}
                <div class="swag-migration-wizard__content-information">
                    {% block swag_migration_magento_wizard_page_credentials_local_hint %}
                        {{ $t('swag-migration.wizard.pages.credentials.magento.local.contentInformation') }}
                    {% endblock %}
                </div>
            {% endblock %}

            {% block swag_migration_magento_wizard_page_credentials_credentials %}
                <div class="swag-migration-wizard__form">
                    {% block swag_migration_magento_wizard_page_credentials_local_db_host_port_group %}
                        <sw-container columns="1fr 80px"
                                      gap="16px">
                            {% block swag_migration_magento_wizard_page_credentials_local_dbhost_field %}
                                <mt-text-field
                                    v-autofocus
                                    v-model="inputCredentials.dbHost"
                                    name="sw-field--dbHost"
                                    :label="$t('swag-migration.wizard.pages.credentials.magento.local.dbHostLabel')"
                                    :placeholder="$t('swag-migration.wizard.pages.credentials.magento.local.dbHostPlaceholder')"
                                ></mt-text-field>
                            {% endblock %}

                            {% block swag_migration_magento_wizard_page_credentials_local_dbport_field %}
                                <mt-text-field
                                    v-model="inputCredentials.dbPort"
                                    name="sw-field--dbPort"
                                    :label="$t('swag-migration.wizard.pages.credentials.magento.local.dbPortLabel')"
                                    :placeholder="$t('swag-migration.wizard.pages.credentials.magento.local.dbPortPlaceholder')"
                                ></mt-text-field>
                            {% endblock %}
                        </sw-container>
                    {% endblock %}

                    {% block swag_migration_magento_wizard_page_credentials_local_dbuser_field %}
                        <mt-text-field
                            v-model="inputCredentials.dbUser"
                            name="sw-field--dbUser"
                            :label="$t('swag-migration.wizard.pages.credentials.magento.local.dbUserLabel')"
                            :placeholder="$t('swag-migration.wizard.pages.credentials.magento.local.dbUserPlaceholder')"
                        ></mt-text-field>
                    {% endblock %}

                    {% block swag_migration_magento_wizard_page_credentials_local_dbpassword_field %}
                        <mt-password-field
                            v-model="inputCredentials.dbPassword"
                            name="sw-field--dbPassword"
                            :label="$t('swag-migration.wizard.pages.credentials.magento.local.dbPasswordLabel')"
                            :placeholder="$t('swag-migration.wizard.pages.credentials.magento.local.dbPasswordPlaceholder')"
                        ></mt-password-field>
                    {% endblock %}

                    {% block swag_migration_magento_wizard_page_credentials_local_dbname_field %}
                        <mt-text-field
                            v-model="inputCredentials.dbName"
                            name="sw-field--dbName"
                            :label="$t('swag-migration.wizard.pages.credentials.magento.local.dbNameLabel')"
                            :placeholder="$t('swag-migration.wizard.pages.credentials.magento.local.dbNamePlaceholder')"
                        ></mt-text-field>
                    {% endblock %}

                    {% block swag_migration_magento_wizard_page_credentials_local_shopurlactive_field %}
                        <mt-switch
                            v-model="shopUrlActive"
                            name="sw-field--shopUrlActive"
                            :label="$t('swag-migration.wizard.pages.credentials.magento.local.shopUrlActiveLabel')"
                            :helpText="$t('swag-migration.wizard.pages.credentials.magento.local.shopUrlActiveHelp')"
                        ></mt-switch>
                    {% endblock %}

                    {% block swag_migration_magento_wizard_page_credentials_local_installationroot_field %}
                        <mt-text-field
                            v-if="shopUrlActive === false"
                            v-model="inputCredentials.installationRoot"
                            name="sw-field--installationRoot"
                            :label="$t('swag-migration.wizard.pages.credentials.magento.local.installationRoot')"
                            :placeholder="$t('swag-migration.wizard.pages.credentials.magento.local.installationRootPlaceholder')"
                            :helpText="$t('swag-migration.wizard.pages.credentials.magento.local.installationRootHelp')"
                        ></mt-text-field>
                    {% endblock %}

                    {% block swag_migration_magento_wizard_page_credentials_local_shopurl_field %}
                        <mt-url-field
                            v-if="shopUrlActive === true"
                            v-model="inputCredentials.shopUrl"
                            name="sw-url-field--shopUrl"
                            :label="$t('swag-migration.wizard.pages.credentials.magento.local.shopUrl')"
                            :placeholder="$t('swag-migration.wizard.pages.credentials.magento.local.shopUrlPlaceholder')"
                            :helpText="$t('swag-migration.wizard.pages.credentials.magento.local.shopUrlHelp')"
                        ></mt-url-field>
                    {% endblock %}

                    {% block swag_migration_magento_wizard_page_credentials_local_tableprefix_field %}
                        <mt-text-field
                            class="swag-migration-wizard__form-table-prefix"
                            v-model="inputCredentials.tablePrefix"
                            name="sw-field--tablePrefix"
                            :label="$t('swag-migration.wizard.pages.credentials.magento.local.tablePrefix')"
                            :placeholder="$t('swag-migration.wizard.pages.credentials.magento.local.tablePrefixPlaceholder')"
                        ></mt-text-field>
                    {% endblock %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}
</div>
